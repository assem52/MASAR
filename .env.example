# Copy to .env and fill in real values. Never commit .env.
# Variable names are provisional until the API and infra exist.

# PostgreSQL with PostGIS
DATABASE_URL=postgresql://masar:masar@localhost:5432/masar

# Redis (latest vehicle positions)
REDIS_URL=redis://localhost:6379

# Authentication
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me

# Shared secret Traccar sends when forwarding positions to the API
INGEST_TOKEN=change-me

# AI provider (backend only, never exposed to web or mobile)
AI_API_KEY=
