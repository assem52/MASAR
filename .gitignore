# Secrets and local environment
# Ignore every env file at any depth; only the template is committed.
# Order matters: the last matching rule wins, so the ! line must come after.
.env*
!.env.example

# Personal Claude Code configuration
CLAUDE.local.md
.claude/settings.local.json

# Dependencies and build output (Node / NestJS / Vite)
node_modules/
dist/
build/
out/
coverage/
*.tsbuildinfo
.eslintcache

# Logs
*.log
logs/

# Editors and OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Local data volumes (Docker)
infra/data/

# Local-only notes
/docs/learning/